# GPT competence service, matching the validation competence classifier.
OPENAI_COMPETENCE_API_KEY=
OPENAI_COMPETENCE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPETENCE_MODEL=gpt-4.1
OPENAI_COMPETENCE_TEMPERATURE=0
OPENAI_TIMEOUT_S=60

# Shared OpenAI-compatible fallback values for services that still read generic names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0
OPENAI_KEYWORD_MODEL=gpt-4.1

# CAVS competence choices: gpt or nesta.
CAVS_COMPETENCE_MODE=nesta
ESCO_JSONL_PATH=/usr/src/app/esco-v1.2.1.jsonl
ESCO_MAX_HOPS=

# OCR3 local demo seeds.
OCR_SEED=12345
OCR_ORACLE0_SEED=101
OCR_ORACLE1_SEED=202
OCR_ORACLE2_SEED=303
OCR_ORACLE3_SEED=404
OCR_ORACLE_SEED=
OCR_ORACLE_SEEDS=

# Smart-contract / Hardhat deployment values.
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
COINMARKETCAP_API_KEY=
CONTRACT_ADDRESS=
OCR_CONTRACT_RPC_URL=
# Optional WebSocket endpoint used only to wake the authoritative range scan.
# benchmark/run.sh defaults this to ws://host.docker.internal:8545 for Anvil.
OCR_CONTRACT_SUBSCRIPTION_RPC_URL=
# Periodic authoritative range reconciliation. A required WebSocket simulation
# uses 30s by default and still retries genuinely pending blobs after ~1s.
OCR_CONTRACT_REQUEST_POLL_INTERVAL=1s
# Bounds initial RPC dial + WebSocket SubscribeFilterLogs acknowledgement.
OCR_CONTRACT_REQUEST_STARTUP_TIMEOUT=15s
# Fail closed instead of falling back to interval polling. Enable only when
# the selected RPC supports WebSocket subscriptions (the causal Anvil runner
# sets this automatically).
OCR_REQUIRE_CONTRACT_SUBSCRIPTION=false
OCR_CONTRACT_ADDRESS=
REPORT_GAS=true
ORACLE_ID=
ORACLE_DID=
ORACLE_ENDPOINT=

# Direct-request script values.
REQUESTER_ENDPOINT=
STATEMENT=
HOLDER_DID=
AUTHOR_SKILLS_JSON=[]
TARGET_ORACLE_IDS_JSON=[]

# Public oracle queue ingress endpoints for smart-contract profile.
OCR_ORACLE0_PUBLIC_ENDPOINT=http://127.0.0.1:21000/requests
OCR_ORACLE1_PUBLIC_ENDPOINT=http://127.0.0.1:21001/requests
OCR_ORACLE2_PUBLIC_ENDPOINT=http://127.0.0.1:21002/requests
OCR_ORACLE3_PUBLIC_ENDPOINT=http://127.0.0.1:21003/requests
