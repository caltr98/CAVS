{
  "name": "cavsonocr-noncentralized",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:no-gas": "REPORT_GAS=false npx hardhat test",
    "deploy:sepolia": "npx hardhat run --network sepolia scripts/deploy.ts",
    "register:oracle": "npx hardhat run --network sepolia scripts/registerOracle.ts",
    "list:oracles": "npx hardhat run --network sepolia scripts/listOracles.ts",
    "submit:request": "npx hardhat run --network sepolia scripts/submitRequest.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.17",
    "typescript": "^5.8.2"
  }
}
