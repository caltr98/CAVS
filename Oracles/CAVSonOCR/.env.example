# Copy this file to .env and edit the network-specific values before running
# docker compose from Oracles/CAVSonOCR.

# Required by bootstrap and all oracle containers in one deployment.
# Override with OCR_SEED="$(date +%s)" for a fresh local run.
OCR_SEED=1700000000

# Per-oracle OCR identity seeds. Keep these distinct.
OCR_ORACLE0_SEED=101
OCR_ORACLE1_SEED=202
OCR_ORACLE2_SEED=303
OCR_ORACLE3_SEED=404

# Smart-contract registry used by the decentralized request path.
OCR_CONTRACT_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
OCR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Public queue endpoints registered on-chain for direct requester delivery.
OCR_ORACLE0_PUBLIC_ENDPOINT=http://127.0.0.1:21000/requests
OCR_ORACLE1_PUBLIC_ENDPOINT=http://127.0.0.1:21001/requests
OCR_ORACLE2_PUBLIC_ENDPOINT=http://127.0.0.1:21002/requests
OCR_ORACLE3_PUBLIC_ENDPOINT=http://127.0.0.1:21003/requests

# CAVSService competence mode. "nesta" requires --profile nesta.
# Use "gpt" to route competence checks to the GPT competence checker instead.
CAVS_COMPETENCE_MODE=nesta

# Required when CAVS_COMPETENCE_MODE=gpt.
OPENAI_COMPETENCE_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPETENCE_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_S=60
